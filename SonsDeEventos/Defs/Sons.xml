<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Verde: evento positivo. Pasta: Sounds/EventosCustom/verde/ -->
  <SoundDef>
    <defName>SE_Verde</defName>
    <context>Any</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>EventosCustom/verde</clipFolderPath>
          </li>
        </grains>
        <volumeRange>80~80</volumeRange>
        <onCamera>true</onCamera>
      </li>
    </subSounds>
  </SoundDef>

